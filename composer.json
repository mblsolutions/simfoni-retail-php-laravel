{
    "name": "mblsolutions/simfoniretail-php-laravel",
    "description": "Official Simfoni Retail interface for Laravel PHP applications.",
    "keywords": ["simfoniretail", "laravel"],
    "type": "package",
    "license": "proprietary",
    "authors": [
        {
            "name": "Redu Group",
            "email": "tech@redu.co.uk"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/session": "^10.0|^11.0|^12.0",
        "illuminate/pagination": "^10.0|^11.0|^12.0",
        "mblsolutions/simfoni-retail-php": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "MBLSolutions\\SimfoniRetailLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MBLSolutions\\SimfoniRetailLaravel\\Tests\\": "tests"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
